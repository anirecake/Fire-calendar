# Copy to .env (never commit it). Only FIRMS_MAP_KEY is needed for the data pipeline.

# NASA FIRMS key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional - AI assistant on the website (Claude). https://console.anthropic.com/ -> API keys
# On Vercel put it in Project Settings -> Environment Variables instead.
ANTHROPIC_API_KEY=

# Optional - Telegram alert bot (bot/firebot.py). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username without @ - shows the "Telegram alerts" button on the website.
TELEGRAM_BOT_USERNAME=
